generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  INVENTORY
  CASHIER
  AGENT
}

enum Channel {
  counter
  field
}

enum OrderStatus {
  pending
  delivered
  cancelled
}

enum LocationSource {
  gps
  manual
}

enum MoveReason {
  initial
  sale
  restock
  adjustment
}

model User {
  id                Int             @id @default(autoincrement())
  firstName         String          @map("first_name")
  lastName          String          @map("last_name")
  email             String          @unique
  mobile            String?
  address           String?
  photoUrl          String?         @map("photo_url")
  role              Role
  employeeId        String          @unique @map("employee_id")
  passwordHash      String          @map("password_hash")
  active            Boolean         @default(true)
  /// Bumped on password change / deactivation to revoke existing tokens.
  tokenVersion      Int             @default(0) @map("token_version")
  /// When the agent acknowledged the work-hours location tracking notice (Data Privacy Act).
  trackingConsentAt DateTime?       @map("tracking_consent_at") @db.Timestamptz
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  itemsCreated      Item[]
  sales             Sale[]
  stockMoves        StockMove[]
  customers         Customer[]      @relation("CustomerCreatedBy")
  orders            Order[]         @relation("OrderAgent")
  delivered         Order[]         @relation("OrderDeliveredBy")
  locationPoints    LocationPoint[]
  stops             AgentStop[]
  locatedStores     Customer[]      @relation("CustomerLocatedBy")

  @@map("users")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  items Item[]

  @@map("categories")
}

/// Money fields are integer centavos.
model Item {
  id           Int         @id @default(autoincrement())
  name         String
  description  String?
  categoryId   Int?        @map("category_id")
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sku          String?     @unique
  unit         String      @default("pc")
  qtyOnHand    Int         @default(0) @map("qty_on_hand")
  reorderLevel Int         @default(0) @map("reorder_level")
  costPrice    Int?        @map("cost_price")
  sellingPrice Int         @map("selling_price")
  imageUrl     String?     @map("image_url")
  createdById  Int?        @map("created_by")
  createdBy    User?       @relation(fields: [createdById], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  saleLines    SaleLine[]
  stockMoves   StockMove[]
  orderLines   OrderLine[]
  packs        ItemPack[]

  @@map("items")
}

model Sale {
  id         Int        @id @default(autoincrement())
  soldAt     DateTime   @default(now()) @map("sold_at") @db.Timestamptz
  cashierId  Int        @map("cashier_id")
  cashier    User       @relation(fields: [cashierId], references: [id])
  channel    Channel    @default(counter)
  total      Int
  lines      SaleLine[]
  customerId Int?       @map("customer_id")
  customer   Customer?  @relation(fields: [customerId], references: [id])
  order      Order?

  @@index([soldAt])
  @@map("sales")
}

model SaleLine {
  id        Int   @id @default(autoincrement())
  saleId    Int   @map("sale_id")
  sale      Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId    Int   @map("item_id")
  item      Item  @relation(fields: [itemId], references: [id])
  qty       Int
  unitPrice Int   @map("unit_price")
  lineTotal Int   @map("line_total")
  /// Pack pricing parts [{packTypeId,name,size,count,price,amount}] (lib/pricing.js); null for legacy rows.
  breakdown Json?

  @@index([itemId])
  @@map("sale_lines")
}

model StockMove {
  id     Int        @id @default(autoincrement())
  itemId Int        @map("item_id")
  item   Item       @relation(fields: [itemId], references: [id])
  change Int
  reason MoveReason
  at     DateTime   @default(now()) @db.Timestamptz
  byId   Int?       @map("by")
  by     User?      @relation(fields: [byId], references: [id])

  @@index([itemId, at])
  @@map("stock_moves")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

/// A store the field agents sell to. client_uuid is set by the device for offline creation.
model Customer {
  id               Int             @id @default(autoincrement())
  clientUuid       String          @unique @default(uuid()) @map("client_uuid")
  name             String
  ownerName        String?         @map("owner_name")
  phone            String?
  address          String?
  notes            String?
  active           Boolean         @default(true)
  lat              Float?
  lng              Float?
  locationSource   LocationSource? @map("location_source")
  locationAccuracy Float?          @map("location_accuracy")
  locatedAt        DateTime?       @map("located_at") @db.Timestamptz
  locatedById      Int?            @map("located_by")
  locatedBy        User?           @relation("CustomerLocatedBy", fields: [locatedById], references: [id])
  stops            AgentStop[]
  createdById      Int?            @map("created_by")
  createdBy        User?           @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  orders           Order[]
  sales            Sale[]

  @@index([updatedAt])
  @@map("customers")
}

/// Field order taken by an agent; becomes a Sale (and moves stock) only when delivered.
model Order {
  id              Int         @id @default(autoincrement())
  clientUuid      String      @unique @map("client_uuid")
  customerId      Int         @map("customer_id")
  customer        Customer    @relation(fields: [customerId], references: [id])
  agentId         Int         @map("agent_id")
  agent           User        @relation("OrderAgent", fields: [agentId], references: [id])
  status          OrderStatus @default(pending)
  orderedAt       DateTime    @map("ordered_at") @db.Timestamptz
  syncedAt        DateTime    @default(now()) @map("synced_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz
  deliveredById   Int?        @map("delivered_by")
  deliveredBy     User?       @relation("OrderDeliveredBy", fields: [deliveredById], references: [id])
  cancelledReason String?     @map("cancelled_reason")
  notes           String?
  total           Int
  saleId          Int?        @unique @map("sale_id")
  sale            Sale?       @relation(fields: [saleId], references: [id])
  lines           OrderLine[]

  @@index([status, orderedAt])
  @@index([agentId, updatedAt])
  @@map("orders")
}

model OrderLine {
  id           Int   @id @default(autoincrement())
  orderId      Int   @map("order_id")
  order        Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       Int   @map("item_id")
  item         Item  @relation(fields: [itemId], references: [id])
  qty          Int
  unitPrice    Int   @map("unit_price")
  lineTotal    Int   @map("line_total")
  deliveredQty Int?  @map("delivered_qty")
  /// Pack pricing parts for the ordered qty (lib/pricing.js).
  breakdown    Json?
  /// Snapshot {retail, packs[]} at order time; partial deliveries are re-priced from it.
  pricing      Json?

  @@map("order_lines")
}

/// Raw GPS fix from an agent's tablet. Kept 12 months (purged daily). Unique per agent+instant for idempotent uploads.
model LocationPoint {
  id         BigInt   @id @default(autoincrement())
  agentId    Int      @map("agent_id")
  agent      User     @relation(fields: [agentId], references: [id])
  recordedAt DateTime @map("recorded_at") @db.Timestamptz
  lat        Float
  lng        Float
  accuracy   Float?
  speed      Float?
  bearing    Float?
  battery    Int?
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@unique([agentId, recordedAt])
  @@map("location_points")
}

/// A detected stop (derived from location_points). Kept beyond the 12-month point retention.
model AgentStop {
  id         Int       @id @default(autoincrement())
  agentId    Int       @map("agent_id")
  agent      User      @relation(fields: [agentId], references: [id])
  day        String /// Manila date YYYY-MM-DD
  startedAt  DateTime  @map("started_at") @db.Timestamptz
  endedAt    DateTime  @map("ended_at") @db.Timestamptz
  durationS  Int       @map("duration_s")
  lat        Float
  lng        Float
  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pointCount Int       @map("point_count")

  @@unique([agentId, startedAt])
  @@index([agentId, day])
  @@index([customerId, startedAt])
  @@map("agent_stops")
}

/// Cached road-snapped geometry per agent-day; recomputed when point_count changes.
model TrackCache {
  agentId    Int      @map("agent_id")
  day        String
  pointCount Int      @map("point_count")
  geometry   Json
  snapped    Boolean
  distanceM  Int      @map("distance_m")
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz

  @@id([agentId, day])
  @@map("track_cache")
}

/// Admin-managed pack names (Dozen, Box, Crate, Case, Sack, …). Each item sets its own size/price in ItemPack.
model PackType {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  defaultSize Int?       @map("default_size")
  sort        Int        @default(0)
  active      Boolean    @default(true)
  itemPacks   ItemPack[]

  @@map("pack_types")
}

/// A wholesale pack for one item: `size` base units sold together for `price` centavos.
model ItemPack {
  id         Int      @id @default(autoincrement())
  itemId     Int      @map("item_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packTypeId Int      @map("pack_type_id")
  packType   PackType @relation(fields: [packTypeId], references: [id])
  size       Int
  price      Int

  @@unique([itemId, packTypeId])
  @@unique([itemId, size])
  @@map("item_packs")
}
