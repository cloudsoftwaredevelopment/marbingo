generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  INVENTORY
  CASHIER
  AGENT
}

enum Channel {
  counter
  field
  truck
}

enum OrderStatus {
  pending
  delivered
  cancelled
}

enum LocationSource {
  gps
  manual
}

enum MoveReason {
  initial
  sale
  restock
  adjustment
  truck_load
  truck_return
}

model User {
  id                      Int             @id @default(autoincrement())
  firstName               String          @map("first_name")
  lastName                String          @map("last_name")
  email                   String          @unique
  mobile                  String?
  address                 String?
  photoUrl                String?         @map("photo_url")
  role                    Role
  employeeId              String          @unique @map("employee_id")
  passwordHash            String          @map("password_hash")
  active                  Boolean         @default(true)
  /// Bumped on password change / deactivation to revoke existing tokens.
  tokenVersion            Int             @default(0) @map("token_version")
  /// When the agent acknowledged the work-hours location tracking notice (Data Privacy Act).
  trackingConsentAt       DateTime?       @map("tracking_consent_at") @db.Timestamptz
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz
  itemsCreated            Item[]
  sales                   Sale[]
  stockMoves              StockMove[]
  customers               Customer[]      @relation("CustomerCreatedBy")
  orders                  Order[]         @relation("OrderAgent")
  delivered               Order[]         @relation("OrderDeliveredBy")
  locationPoints          LocationPoint[]
  deviceEvents            DeviceEvent[]
  stops                   AgentStop[]
  locatedStores           Customer[]      @relation("CustomerLocatedBy")
  truck                   Truck?
  truckPeriodsOpened      TruckPeriod[]   @relation("PeriodOpenedBy")
  truckPeriodsClosed      TruckPeriod[]   @relation("PeriodClosedBy")
  truckTransfersRequested TruckTransfer[] @relation("TransferRequestedBy")
  truckTransfersDecided   TruckTransfer[] @relation("TransferDecidedBy")
  truckMoves              TruckMove[]
  truckCounts             TruckCount[]

  @@map("users")
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  items Item[]

  @@map("categories")
}

/// Money fields are integer centavos.
model Item {
  id            Int                 @id @default(autoincrement())
  name          String
  description   String?
  categoryId    Int?                @map("category_id")
  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sku           String?             @unique
  unit          String              @default("pc")
  qtyOnHand     Int                 @default(0) @map("qty_on_hand")
  reorderLevel  Int                 @default(0) @map("reorder_level")
  costPrice     Int?                @map("cost_price")
  sellingPrice  Int                 @map("selling_price")
  imageUrl      String?             @map("image_url")
  createdById   Int?                @map("created_by")
  createdBy     User?               @relation(fields: [createdById], references: [id])
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  saleLines     SaleLine[]
  stockMoves    StockMove[]
  orderLines    OrderLine[]
  packs         ItemPack[]
  truckStock    TruckStock[]
  truckMoves    TruckMove[]
  transferLines TruckTransferLine[]
  countLines    TruckCountLine[]

  @@map("items")
}

model Sale {
  id         Int        @id @default(autoincrement())
  soldAt     DateTime   @default(now()) @map("sold_at") @db.Timestamptz
  cashierId  Int        @map("cashier_id")
  cashier    User       @relation(fields: [cashierId], references: [id])
  channel    Channel    @default(counter)
  total      Int
  lines      SaleLine[]
  customerId Int?       @map("customer_id")
  customer   Customer?  @relation(fields: [customerId], references: [id])
  order      Order?
  truckSale  TruckSale?

  @@index([soldAt])
  @@map("sales")
}

model SaleLine {
  id        Int   @id @default(autoincrement())
  saleId    Int   @map("sale_id")
  sale      Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId    Int   @map("item_id")
  item      Item  @relation(fields: [itemId], references: [id])
  qty       Int
  unitPrice Int   @map("unit_price")
  lineTotal Int   @map("line_total")
  /// Pack pricing parts [{packTypeId,name,size,count,price,amount}] (lib/pricing.js); null for legacy rows.
  breakdown Json?

  @@index([itemId])
  @@map("sale_lines")
}

model StockMove {
  id     Int        @id @default(autoincrement())
  itemId Int        @map("item_id")
  item   Item       @relation(fields: [itemId], references: [id])
  change Int
  reason MoveReason
  at     DateTime   @default(now()) @db.Timestamptz
  byId   Int?       @map("by")
  by     User?      @relation(fields: [byId], references: [id])

  @@index([itemId, at])
  @@map("stock_moves")
}

model Setting {
  key   String @id
  value String

  @@map("settings")
}

/// A store the field agents sell to. client_uuid is set by the device for offline creation.
model Customer {
  id               Int             @id @default(autoincrement())
  clientUuid       String          @unique @default(uuid()) @map("client_uuid")
  name             String
  ownerName        String?         @map("owner_name")
  phone            String?
  address          String?
  notes            String?
  active           Boolean         @default(true)
  lat              Float?
  lng              Float?
  locationSource   LocationSource? @map("location_source")
  locationAccuracy Float?          @map("location_accuracy")
  locatedAt        DateTime?       @map("located_at") @db.Timestamptz
  locatedById      Int?            @map("located_by")
  locatedBy        User?           @relation("CustomerLocatedBy", fields: [locatedById], references: [id])
  stops            AgentStop[]
  createdById      Int?            @map("created_by")
  createdBy        User?           @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  orders           Order[]
  sales            Sale[]

  @@index([updatedAt])
  @@map("customers")
}

/// Field order taken by an agent; becomes a Sale (and moves stock) only when delivered.
model Order {
  id              Int         @id @default(autoincrement())
  clientUuid      String      @unique @map("client_uuid")
  customerId      Int         @map("customer_id")
  customer        Customer    @relation(fields: [customerId], references: [id])
  agentId         Int         @map("agent_id")
  agent           User        @relation("OrderAgent", fields: [agentId], references: [id])
  status          OrderStatus @default(pending)
  orderedAt       DateTime    @map("ordered_at") @db.Timestamptz
  syncedAt        DateTime    @default(now()) @map("synced_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deliveredAt     DateTime?   @map("delivered_at") @db.Timestamptz
  deliveredById   Int?        @map("delivered_by")
  deliveredBy     User?       @relation("OrderDeliveredBy", fields: [deliveredById], references: [id])
  cancelledReason String?     @map("cancelled_reason")
  notes           String?
  total           Int
  saleId          Int?        @unique @map("sale_id")
  sale            Sale?       @relation(fields: [saleId], references: [id])
  lines           OrderLine[]

  @@index([status, orderedAt])
  @@index([agentId, updatedAt])
  @@map("orders")
}

model OrderLine {
  id           Int   @id @default(autoincrement())
  orderId      Int   @map("order_id")
  order        Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       Int   @map("item_id")
  item         Item  @relation(fields: [itemId], references: [id])
  qty          Int
  unitPrice    Int   @map("unit_price")
  lineTotal    Int   @map("line_total")
  deliveredQty Int?  @map("delivered_qty")
  /// Pack pricing parts for the ordered qty (lib/pricing.js).
  breakdown    Json?
  /// Snapshot {retail, packs[]} at order time; partial deliveries are re-priced from it.
  pricing      Json?

  @@map("order_lines")
}

/// Raw GPS fix from an agent's tablet. Kept 12 months (purged daily). Unique per agent+instant for idempotent uploads.
model LocationPoint {
  id         BigInt   @id @default(autoincrement())
  agentId    Int      @map("agent_id")
  agent      User     @relation(fields: [agentId], references: [id])
  recordedAt DateTime @map("recorded_at") @db.Timestamptz
  lat        Float
  lng        Float
  accuracy   Float?
  speed      Float?
  bearing    Float?
  battery    Int?
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@unique([agentId, recordedAt])
  @@map("location_points")
}

/// Tablet state changes during work hours (power, app, mobile data, GPS, …): docs/tracking-api.md "Device log".
model DeviceEvent {
  id         BigInt   @id @default(autoincrement())
  agentId    Int      @map("agent_id")
  agent      User     @relation(fields: [agentId], references: [id])
  type       String /// power_off, data_on, … (lib/deviceEvents.js TYPES)
  at         DateTime @db.Timestamptz
  detail     Json?
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@unique([agentId, type, at])
  @@index([agentId, at])
  @@map("device_events")
}

/// A detected stop (derived from location_points). Kept beyond the 12-month point retention.
model AgentStop {
  id         Int       @id @default(autoincrement())
  agentId    Int       @map("agent_id")
  agent      User      @relation(fields: [agentId], references: [id])
  day        String /// Manila date YYYY-MM-DD
  startedAt  DateTime  @map("started_at") @db.Timestamptz
  endedAt    DateTime  @map("ended_at") @db.Timestamptz
  durationS  Int       @map("duration_s")
  lat        Float
  lng        Float
  customerId Int?      @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pointCount Int       @map("point_count")

  @@unique([agentId, startedAt])
  @@index([agentId, day])
  @@index([customerId, startedAt])
  @@map("agent_stops")
}

/// Cached road-snapped geometry per agent-day; recomputed when point_count changes.
model TrackCache {
  agentId    Int      @map("agent_id")
  day        String
  pointCount Int      @map("point_count")
  geometry   Json
  snapped    Boolean
  distanceM  Int      @map("distance_m")
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz

  @@id([agentId, day])
  @@map("track_cache")
}

/// Admin-managed pack names (Dozen, Box, Crate, Case, Sack, …). Each item sets its own size/price in ItemPack.
model PackType {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  defaultSize Int?       @map("default_size")
  sort        Int        @default(0)
  active      Boolean    @default(true)
  itemPacks   ItemPack[]

  @@map("pack_types")
}

/// A wholesale pack for one item: `size` base units sold together for `price` centavos.
model ItemPack {
  id         Int      @id @default(autoincrement())
  itemId     Int      @map("item_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packTypeId Int      @map("pack_type_id")
  packType   PackType @relation(fields: [packTypeId], references: [id])
  size       Int
  price      Int

  @@unique([itemId, packTypeId])
  @@unique([itemId, size])
  @@map("item_packs")
}

enum TruckMoveReason {
  load
  topup
  return
  sale
  count_variance
}

enum PeriodStatus {
  draft
  open
  counting
  closed
}

enum TransferKind {
  load
  topup
  return
}

enum TransferStatus {
  pending
  approved
  rejected
}

/// A truck is a mobile warehouse. A truck agent is the AGENT assigned to it (agentId).
model Truck {
  id         Int             @id @default(autoincrement())
  name       String
  plate      String?
  driverName String?         @map("driver_name")
  agentId    Int?            @unique @map("agent_id")
  agent      User?           @relation(fields: [agentId], references: [id])
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  stock      TruckStock[]
  periods    TruckPeriod[]
  transfers  TruckTransfer[]
  moves      TruckMove[]
  sales      TruckSale[]

  @@map("trucks")
}

/// Materialised balance of truck_moves (qty == SUM(change)). May go negative after an offline oversell.
model TruckStock {
  truckId Int   @map("truck_id")
  truck   Truck @relation(fields: [truckId], references: [id])
  itemId  Int   @map("item_id")
  item    Item  @relation(fields: [itemId], references: [id])
  qty     Int

  @@id([truckId, itemId])
  @@map("truck_stock")
}

/// One month of a truck's life. At most one non-closed period per truck (partial unique index in the migration).
model TruckPeriod {
  id              Int             @id @default(autoincrement())
  truckId         Int             @map("truck_id")
  truck           Truck           @relation(fields: [truckId], references: [id])
  /// Manila month, YYYY-MM.
  month           String
  status          PeriodStatus    @default(draft)
  /// Beginning inventory [{itemId, qty}] set when the manager opens the period.
  openingSnapshot Json?           @map("opening_snapshot")
  openedAt        DateTime?       @map("opened_at") @db.Timestamptz
  openedById      Int?            @map("opened_by")
  openedBy        User?           @relation("PeriodOpenedBy", fields: [openedById], references: [id])
  countStartedAt  DateTime?       @map("count_started_at") @db.Timestamptz
  closedAt        DateTime?       @map("closed_at") @db.Timestamptz
  closedById      Int?            @map("closed_by")
  closedBy        User?           @relation("PeriodClosedBy", fields: [closedById], references: [id])
  /// Frozen reconcile report, written at close.
  report          Json?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  transfers       TruckTransfer[]
  moves           TruckMove[]
  truckSales      TruckSale[]
  count           TruckCount?

  @@unique([truckId, month])
  @@map("truck_periods")
}

model TruckTransfer {
  id            Int                 @id @default(autoincrement())
  truckId       Int                 @map("truck_id")
  truck         Truck               @relation(fields: [truckId], references: [id])
  periodId      Int?                @map("period_id")
  period        TruckPeriod?        @relation(fields: [periodId], references: [id])
  kind          TransferKind
  status        TransferStatus      @default(pending)
  note          String?
  requestedById Int                 @map("requested_by")
  requestedBy   User                @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime            @default(now()) @map("requested_at") @db.Timestamptz
  decidedById   Int?                @map("decided_by")
  decidedBy     User?               @relation("TransferDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz
  lines         TruckTransferLine[]

  @@index([truckId, status])
  @@map("truck_transfers")
}

model TruckTransferLine {
  id         Int           @id @default(autoincrement())
  transferId Int           @map("transfer_id")
  transfer   TruckTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId     Int           @map("item_id")
  item       Item          @relation(fields: [itemId], references: [id])
  qty        Int

  @@map("truck_transfer_lines")
}

/// Truck ledger. Every truck_stock change writes a row here.
model TruckMove {
  id       Int             @id @default(autoincrement())
  truckId  Int             @map("truck_id")
  truck    Truck           @relation(fields: [truckId], references: [id])
  itemId   Int             @map("item_id")
  item     Item            @relation(fields: [itemId], references: [id])
  periodId Int             @map("period_id")
  period   TruckPeriod     @relation(fields: [periodId], references: [id])
  change   Int
  reason   TruckMoveReason
  at       DateTime        @default(now()) @db.Timestamptz
  /// 'transfer' | 'sale' | 'period'
  refType  String?         @map("ref_type")
  refId    Int?            @map("ref_id")
  byId     Int?            @map("by")
  by       User?           @relation(fields: [byId], references: [id])

  @@index([truckId, itemId])
  @@index([periodId])
  @@index([itemId, at])
  @@map("truck_moves")
}

/// A sale made from the truck (offline on the tablet). The Sale row (channel truck) carries lines and total.
model TruckSale {
  id         Int         @id @default(autoincrement())
  clientUuid String      @unique @map("client_uuid")
  saleId     Int         @unique @map("sale_id")
  sale       Sale        @relation(fields: [saleId], references: [id])
  truckId    Int         @map("truck_id")
  truck      Truck       @relation(fields: [truckId], references: [id])
  periodId   Int         @map("period_id")
  period     TruckPeriod @relation(fields: [periodId], references: [id])
  /// Truck stock went below zero because of this sale.
  oversold   Boolean     @default(false)
  /// Synced after its own period closed (or before it opened), so posted to the current period.
  late       Boolean     @default(false)
  syncedAt   DateTime    @default(now()) @map("synced_at") @db.Timestamptz

  @@index([periodId])
  @@map("truck_sales")
}

model TruckCount {
  id          Int              @id @default(autoincrement())
  periodId    Int              @unique @map("period_id")
  period      TruckPeriod      @relation(fields: [periodId], references: [id])
  countedById Int              @map("counted_by")
  countedBy   User             @relation(fields: [countedById], references: [id])
  countedAt   DateTime         @default(now()) @map("counted_at") @db.Timestamptz
  lines       TruckCountLine[]

  @@map("truck_counts")
}

model TruckCountLine {
  id      Int        @id @default(autoincrement())
  countId Int        @map("count_id")
  count   TruckCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemId  Int        @map("item_id")
  item    Item       @relation(fields: [itemId], references: [id])
  counted Int

  @@unique([countId, itemId])
  @@map("truck_count_lines")
}
